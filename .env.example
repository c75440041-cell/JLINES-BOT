# Copia a .env solo para pruebas en tu PC. En Railway, estas variables van en la pestaña Variables.
# No subas el archivo .env a GitHub.

# BingX (solo necesarias con MODE=trade)
BINGX_API_KEY=
BINGX_API_SECRET=

# Telegram (obligatorias)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Modo: signals = solo avisos | trade = opera en spot
MODE=signals
QUOTE=USDT
TRADE_USDT=20
MAX_POSITIONS=3

# Mercado: volumen mínimo en 24h (en USDT) y pares a excluir separados por comas
MIN_QUOTE_VOLUME=500000
MAX_SYMBOLS=0
BLACKLIST=

# Estrategia
MIN_SCORE=5
STOP_ATR_MULT=1.5
TP_R_MULT=2.0

# Alertas
COOLDOWN_MIN=60
MAX_ALERTS=10
NOTIFY_SHORTS=true
HEARTBEAT_MIN=60

# Rendimiento y vigilancia de posiciones
CONCURRENCY=5
MONITOR_SECONDS=30

# Estado: en Railway se detecta el Volume solo. Define esto únicamente si lo necesitas.
# STATE_FILE=/data/state.json
